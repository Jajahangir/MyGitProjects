#!/bin/bash
set -euo pipefail

# -------------------------------------------------------------------
# Скрипт установки Prometheus Server на Linux (Ubuntu/Debian)
# -------------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
   echo "Ошибка: Этот скрипт должен быть запущен с правами superuser (sudo)." >&2
   exit 1
fi

PROMETHEUS_VERSION="2.51.1"
ARCH="amd64"

# Стандартные пути согласно FHS
CONFIG_DIR="/etc/prometheus"
DATA_DIR="/var/lib/prometheus"
BIN_DIR="/usr/local/bin"

# Параметры хранения данных
RETENTION_TIME="30d"
RETENTION_SIZE="50GB"

echo "==> Создание системного пользователя и директорий..."
if ! id "prometheus" &>/dev/null; then
    useradd --no-create-home --shell /bin/false --system prometheus
fi

mkdir -p "${CONFIG_DIR}" "${CONFIG_DIR}/rules" "${DATA_DIR}"

echo "==> Загрузка и распаковка Prometheus v${PROMETHEUS_VERSION}..."
TMP_DIR=$(mktemp -d)
trap 'rm -rf "${TMP_DIR}"' EXIT

wget -q --show-progress -O "${TMP_DIR}/prometheus.tar.gz" \
  "https://github.com/prometheus/prometheus/releases/download/v${PROMETHEUS_VERSION}/prometheus-${PROMETHEUS_VERSION}.linux-${ARCH}.tar.gz"

tar -xvzf "${TMP_DIR}/prometheus.tar.gz" -C "${TMP_DIR}" --strip-components=1

echo "==> Установка бинарных файлов и веб-библиотек..."
cp "${TMP_DIR}/prometheus" "${BIN_DIR}/"
cp "${TMP_DIR}/promtool" "${BIN_DIR}/"

# Копирование консолей и консольных библиотек
cp -r "${TMP_DIR}/consoles" "${CONFIG_DIR}/"
cp -r "${TMP_DIR}/console_libraries" "${CONFIG_DIR}/"

echo "==> Создание конфигурации..."
cat <<'EOF' > "${CONFIG_DIR}/prometheus.yml"
global:
  scrape_interval: 15s #time of checking
  evaluation_interval: 15s

rule_files:
  # - "rules/*.yml"

scrape_configs:
  - job_name: "prometheus"
    scrape_interval: 15s
    static_configs:
      - targets: ["localhost:9090"]
EOF

echo "==> Настройка прав доступа..."
chown -R prometheus:prometheus "${CONFIG_DIR}"
chown -R prometheus:prometheus "${DATA_DIR}"
chmod -R 750 "${CONFIG_DIR}"
chmod 750 "${DATA_DIR}"
chown prometheus:prometheus "${BIN_DIR}/prometheus" "${BIN_DIR}/promtool"

echo "==> Валидация конфигурации с помощью promtool..."
promtool check config "${CONFIG_DIR}/prometheus.yml"

echo "==> Создание systemd-юнита..."
cat <<EOF > /etc/systemd/system/prometheus.service
[Unit]
Description=Prometheus Monitoring System and Time Series Database
Documentation=https://prometheus.io/docs/introduction/overview/
After=network-online.target
Wants=network-online.target

[Service]
User=prometheus 
Group=prometheus  
Type=simple
Restart=on-failure
RestartSec=5

ExecStart=${BIN_DIR}/prometheus \\
  --config.file=${CONFIG_DIR}/prometheus.yml \\
  --storage.tsdb.path=${DATA_DIR} \\
  --storage.tsdb.retention.time=${RETENTION_TIME} \\
  --storage.tsdb.retention.size=${RETENTION_SIZE} \\
  --web.console.templates=${CONFIG_DIR}/consoles \\
  --web.console.libraries=${CONFIG_DIR}/console_libraries \\
  --web.enable-lifecycle \\
  --web.listen-address=0.0.0.0:9090

ExecReload=/bin/kill -HUP \$MAINPID
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF

echo "==> Запуск сервиса..."
systemctl daemon-reload
systemctl enable --now prometheus

echo "==> Проверка статуса:"
systemctl is-active --quiet prometheus && echo "Prometheus успешно запущен!" || echo "Ошибка запуска Prometheus"
prometheus --version
